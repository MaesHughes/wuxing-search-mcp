# SearXNG 配置文件 - Wuxing Search
use_default_settings: true
general:
  instance_name: "Wuxing Search"
server:
  port: 8080
  bind_address: "0.0.0.0"
  secret_key: "wuxing-search-secret-key-change-in-production"
  limiter: false
  public_instance: false
  method: "POST"
  image_proxy: false
search:
  formats:
    - html
    - json
    - csv
  max_results: 20

outgoing:
  request_timeout: 10.0
  pool_connections: 100
  pool_maxsize: 20

engines:
  # 通用搜索
  - name: google
    engine: google
    timeout: 10.0
  - name: bing
    engine: bing
    timeout: 10.0
  - name: duckduckgo
    engine: duckduckgo
    timeout: 10.0
  - name: baidu
    engine: baidu
    timeout: 10.0

  # 代码仓库
  - name: github
    engine: github
    timeout: 10.0
  - name: huggingface
    engine: huggingface
    timeout: 10.0

  # 技术问答
  - name: stackoverflow
    engine: stackexchange
    timeout: 10.0

  # 包管理器
  - name: pypi
    engine: pypi
    timeout: 10.0
  - name: npm
    engine: npm
    timeout: 10.0

  # 学术论文
  - name: arxiv
    engine: arxiv
    timeout: 10.0

  # 开发者社区
  - name: hackernews
    engine: hackernews
    timeout: 10.0
  - name: reddit
    engine: reddit
    timeout: 10.0

  # 开发文档
  - name: mdn
    engine: json_engine
    timeout: 10.0

  # 第二批：学术搜索增强
  - name: google scholar
    engine: google_scholar
    timeout: 10.0
  - name: semantic scholar
    engine: semantic_scholar
    timeout: 10.0
  - name: pubmed
    engine: pubmed
    timeout: 10.0

  # 第二批：代码仓库扩展
  - name: gitlab
    engine: gitlab
    disabled: false
    timeout: 10.0

  # 第二批：包管理器扩展
  - name: crates.io
    engine: crates
    disabled: false
    timeout: 10.0
  - name: docker hub
    engine: docker_hub
    timeout: 10.0

  # 第二批：社交媒体扩展
  - name: mastodon hashtags
    engine: mastodon
    timeout: 10.0

  # 第二批：新闻源
  - name: google news
    engine: google_news
    timeout: 10.0
